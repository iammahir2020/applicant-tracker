{
    "name": "applicant-tracker",
    "lockfileVersion": 3,
    "requires": true,
    "packages": {
        "": {
            "workspaces": [
                "apps/*",
                "services/*"
            ],
            "engines": {
                "node": ">=22"
            }
        },
        "apps/web": {
            "name": "@tracker/web",
            "version": "0.0.1"
        },
        "node_modules/@tracker/applications": {
            "resolved": "services/applications",
            "link": true
        },
        "node_modules/@tracker/bff": {
            "resolved": "services/bff",
            "link": true
        },
        "node_modules/@tracker/companies": {
            "resolved": "services/companies",
            "link": true
        },
        "node_modules/@tracker/events-worker": {
            "resolved": "services/events-worker",
            "link": true
        },
        "node_modules/@tracker/web": {
            "resolved": "apps/web",
            "link": true
        },
        "services/applications": {
            "name": "@tracker/applications",
            "version": "0.0.1"
        },
        "services/bff": {
            "name": "@tracker/bff",
            "version": "0.0.1"
        },
        "services/companies": {
            "name": "@tracker/companies",
            "version": "0.0.1"
        },
        "services/events-worker": {
            "name": "@tracker/events-worker",
            "version": "0.0.1"
        }
    }
}
